---
 tools/xenstored/list.h | 15 +++++++++++++++
 1 file changed, 15 insertions(+)

diff --git a/tools/xenstored/list.h b/tools/xenstored/list.h
index d722a91220..8e76eb09bb 100644
--- a/tools/xenstored/list.h
+++ b/tools/xenstored/list.h
@@ -156,6 +156,21 @@ static inline int list_empty(struct list_head *head)
 	return head->next == head;
 }
 
+/*
+ * list_empty - test whether a list is empty
+ *
+ *  @head: ths list to test
+ *
+ *  static inline int list_empty(struct list_head *head)
+ *  {
+ *       return head->next == head->prev
+ *
+ *  }
+ *
+ *  if the tail points to the head, then the list is empty
+ *
+ *
+ */
 static inline void __list_splice(struct list_head *list,
 				 struct list_head *head)
 {
